@model IEnumerable<CareerGuidance.Models.JobApplication>

@{
    ViewData["Title"] = "Applications for Job";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4">
    <div class="container xl">

        <h2>Applications:</h2>

        @if (!Model.Any())
        {
            <p>No applications found for this job.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Applicant Name</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Resume</th>
                        <th>Change Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model)
                    {
                        <tr>
                            <td>@app.User?.Username</td>
                            <td>@app.Email</td>
                            <td>@app.Status</td>
                            <td><a href="~/@app.ResumePath" target="_blank">View Resume</a></td>
                            <td>
                                <form asp-action="UpdateJobStatus" method="post">
                                    <input type="hidden" name="id" value="@app.JobApplicationId" />
                                    <select name="actionStatus" class="form-select d-inline-block w-auto">
                                        <option value="Pending" selected>Pending</option>
                                        <option value="Accept">Accept</option>
                                        <option value="Reject">Reject</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-info ms-1">Update</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>
</div>
