@model IEnumerable<CareerGuidance.Models.Event>
@{
    ViewData["Title"] = "My Webinars";
    Layout = "~/Views/Shared/_MentorLayout.cshtml";
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4">
    <div class="container-xl">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="text-info">My Webinars</h3>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="mb-0">
                    Total Webinars: <span id="totalCount" class="badge bg-info">@Model.Count()</span>
                </h5>
            </div>

            <div class="input-group w-50">
                <input type="text" id="searchInput" class="form-control" placeholder="Search by title, venue, date/time..." />
                <span class="input-group-text bg-info text-white">
                    <i class="bi bi-search"></i>
                </span>
            </div>
        </div>

        <hr>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h5 class="text-muted">No webinars found.</h5>
            </div>
        }
        else
        {
            <div class="row g-4" id="webinarList">
                @foreach (var item in Model)
                {
                    <div class="col-12 col-md-4 webinar-card">
                        <div class="card h-100 border-0 shadow-sm hover-shadow transition-all" style="min-height: 420px;">
                            <div class="position-relative">
                                <img src="~/images/@(string.IsNullOrEmpty(item.ImageSrc) ? "default-banner.jpg" : item.ImageSrc)"
                                     class="card-img-top rounded-top"
                                     alt="@item.Title"
                                     style="height: 220px; object-fit: cover;">
                                <span class="badge bg-info position-absolute top-0 end-0 m-2"
                                      style="max-width: 200px; white-space: normal; word-wrap: break-word; font-size: 0.75rem;">
                                    @item.DateTimeText
                                </span>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title text-info fw-semibold mb-2">@item.Title</h5>
                                <p class="card-text text-muted small mb-2">
                                    <i class="bi bi-geo-alt-fill me-1 text-danger"></i>@item.Venue
                                </p>
                                <p class="text-secondary small">
                                    @(item.Description?.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)
                                </p>
                            </div>
                            <div class="card-footer bg-light border-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <a asp-controller="MentorEventApplications" asp-action="ByEvent" asp-route-eventId="@item.EventId"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-people-fill me-1"></i>Applications
                                    </a>
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-controller="MentorEvents" asp-action="Edit" asp-route-id="@item.EventId"
                                       class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="Delete" asp-controller="MentorEvents" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@item.EventId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete this webinar?');">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // ========================
        // TempData Alerts
        // ========================
        @if (TempData["msg"] != null)
        {
                <text>alert("@TempData["msg"]");</text>
        }

        // ========================
        // Live Search
        // ========================
        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('keyup', function () {
                const query = this.value.toLowerCase().trim();
                document.querySelectorAll('.webinar-card').forEach(card => {
                    const title = card.querySelector('.card-title').textContent.toLowerCase().trim();
                    const venueElem = card.querySelector('.card-text i');
                    const venue = card.querySelector('.card-text').textContent
                        .replace(venueElem?.textContent || '', '')
                        .toLowerCase().trim();
                    const dateTime = card.querySelector('.badge')?.textContent.toLowerCase().trim() || '';
                    card.style.display = (title.includes(query) || venue.includes(query) || dateTime.includes(query)) ? 'block' : 'none';
                });
            });
        }

        // ========================
        // Hover Shadow
        // ========================
        document.querySelectorAll('.hover-shadow').forEach(card => {
            card.addEventListener('mouseenter', () => card.classList.add('shadow-lg'));
            card.addEventListener('mouseleave', () => card.classList.remove('shadow-lg'));
        });
    </script>
}
