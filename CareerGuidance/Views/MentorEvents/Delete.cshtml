@model CareerGuidance.Models.Event
@{
    ViewData["Title"] = "Delete Webinar";
    Layout = "~/Views/Shared/_MentorLayout.cshtml";
}
<div class="app-content mt-5 pt-3 p-md-3 p-lg-4">
    <div class="container xl">
        <h2>Delete Webinar</h2>
        <h4>Are you sure you want to delete this event?</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Title</dt>
            <dd class="col-sm-10">@Model.Title</dd>

            <dt class="col-sm-2">Date</dt>
            <dd class="col-sm-10">@Model.DateTimeText</dd>

            <dt class="col-sm-2">Venue</dt>
            <dd class="col-sm-10">@Model.Venue</dd>

            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@Model.Description</dd>

            @if (!string.IsNullOrEmpty(Model.ImageSrc))
            {
                <dt class="col-sm-2">Image</dt>
                <dd class="col-sm-10">
                    <img src="~/images/@Model.ImageSrc" alt="Event Image" width="200" class="img-thumbnail" />
                </dd>
            }
        </dl>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="EventId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
</<div>
</div>
