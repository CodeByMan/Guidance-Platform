@model IEnumerable<CareerGuidance.Models.EventApplication>
@{
    ViewData["Title"] = "My Event Applications";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4">
    <div class="container-xl">

        <h2 class="mb-4">My Event Applications</h2>

        @if (TempData["msg"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @TempData["msg"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @{
            var conferences = Model.Where(a => a.Event.Type == "Conference").ToList();
            var webinars = Model.Where(a => a.Event.Type == "Webinar").ToList();
        }

        <!-- Conference Applications -->
        <div class="card mb-5 shadow-sm border-info">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0"><i class="bi bi-journal-check"></i> Conference Applications</h4>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered mb-0">
                        <thead class="table-primary">
                            <tr>
                                <th>Event Title</th>
                                <th>Created By</th>
                                <th>Status</th>
                                <th>Message</th>
                                <th>Registration No.</th>
                                <th>Meeting Link</th>
                                <th>Applied On</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (conferences.Any())
                            {
                                foreach (var app in conferences)
                                {
                                    <tr>
                                        <td>@app.Event.Title</td>
                                        <td>@app.Event.User?.Username</td>
                                        <td>@app.Status</td>
                                        <td>@app.Message</td>
                                        <td>@app.RegistrationNumber</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(app.MeetingLink))
                                            {
                                                <a href="@app.MeetingLink" target="_blank" class="btn btn-sm btn-outline-info">Join</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">TBD</span>
                                            }
                                        </td>
                                        <td>@app.AppliedAt.ToString("g")</td>
                                        <td>
                                            <form asp-action="Delete" asp-controller="UserEventApplications" method="post" onsubmit="return confirm('Are you sure you want to remove this application?');">
                                                <input type="hidden" name="applicationId" value="@app.EventApplicationId" />
                                                <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> Remove</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="8" class="text-center text-muted py-3">No conference applications found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Webinar Applications -->
        <div class="card mb-5 shadow-sm border-info">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0"><i class="bi bi-easel2"></i> Webinar Applications</h4>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered mb-0">
                        <thead class="table-primary">
                            <tr>
                                <th>Event Title</th>
                                <th>Created By</th>
                                <th>Status</th>
                                <th>Message</th>
                                <th>Registration No.</th>
                                <th>Meeting Link</th>
                                <th>Applied On</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (webinars.Any())
                            {
                                foreach (var app in webinars)
                                {
                                    <tr>
                                        <td>@app.Event.Title</td>
                                        <td>@app.Event.User?.Username</td>
                                        <td>@app.Status</td>
                                        <td>@app.Message</td>
                                        <td>@app.RegistrationNumber</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(app.MeetingLink))
                                            {
                                                <a href="@app.MeetingLink" target="_blank" class="btn btn-sm btn-outline-info">Join</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">TBD</span>
                                            }
                                        </td>
                                        <td>@app.AppliedAt.ToString("g")</td>
                                        <td>
                                            <form asp-action="Delete" asp-controller="UserApplications" method="post" onsubmit="return confirm('Are you sure you want to remove this application?');">
                                                <input type="hidden" name="applicationId" value="@app.EventApplicationId" />
                                                <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> Remove</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="8" class="text-center text-muted py-3">No webinar applications found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>
