@model List<CareerGuidance.Models.MentorRequest>

@{
    ViewData["Title"] = "My Mentor Requests";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4">
    <div class="container xl">

        <h2 class="text-info mb-4">My Mentor Requests</h2>

        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle text-center">
                <thead class="table-primary text-info">
                    <tr>
                        <th>Mentor</th>
                        <th>Status</th>
                        <th>Meeting Link</th>
                        <th>Scheduled Date</th>
                        <th>Requested At</th>
                        <th>Actions</th> <!-- Added Action Column -->
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var req in Model)
                        {
                            <tr>
                                <td>@req.Mentor?.Username</td>
                                <td>@req.Status.ToString()</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(req.MeetingLink))
                                    {
                                        <a href="@req.MeetingLink" target="_blank" class="btn btn-sm btn-outline-info">Join Meeting</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (req.ScheduledDate.HasValue)
                                    {
                                        @req.ScheduledDate.Value.ToLocalTime().ToString("g")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@req.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td>
                                    <form asp-action="DeleteMentorRequest" asp-controller="User" method="post"
                                          asp-route-requestId="@req.MentorRequestId"
                                          onsubmit="return confirm('Are you sure you want to delete this request?');"
                                          class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="fa fa-trash"></i> Delete
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-muted">You have no mentor requests at the moment.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
