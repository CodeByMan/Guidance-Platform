@model IEnumerable<CareerGuidance.Models.Job>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Closed Jobs";
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4 bg-light">
    <div class="container-xl">
    <h3 class="text-info mb-4 text-center">Closed Jobs</h3>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="Index" class="btn btn-secondary text-white">Back To View Jobs</a>
            <h5 class="mb-0">
                Total Jobs: <span id="totalCount" class="badge bg-info">@Model.Count()</span>
            </h5>
            <form asp-action="DeleteAllClosed" method="post" onsubmit="return confirm('Are you sure you want to delete all closed jobs?');">
                <button type="submit" class="btn btn-danger mb-3">Delete All Closed Jobs</button>
            </form>
        </div>

        <!-- Bottom row: Full-width search bar -->
        <div class="input-group">
            <input type="text" id="searchInput" class="form-control" placeholder="Search by title, location, job type, deadline..." />
            <span class="input-group-text bg-info text-white">
                <i class="bi bi-search"></i>
            </span>
        </div>
    </div>


    <hr>


    <table class="table table-bordered table-hover">
        <thead class="table-primary">
            <tr>
                <th>Title</th>
                <th>Location</th>
                <th>Job Type</th>
                <th>Deadline</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center">No closed jobs found.</td>
                </tr>
            }
            else
            {
                foreach (var job in Model)
                {
                    <tr>
                        <td>@job.Title</td>
                        <td>@job.Location</td>
                        <td>@job.JobType</td>
                        <td>@job.Deadline.ToString("yyyy-MM-dd")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@job.JobId" class="btn btn-secondary btn-sm">Details</a>
                            <a asp-action="Edit" asp-route-id="@job.JobId" class="btn btn-warning btn-sm">Edit</a>
                            <form asp-action="Delete" asp-route-id="@job.JobId" method="post" style="display:inline"
                                  onsubmit="return confirm('Are you sure you want to delete this job?');">
                                <input type="hidden" name="redirectTo" value="ClosedJobs" />
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                                <a asp-controller="AdminApplications" asp-action="JobApplicationsByJob" asp-route-jobId="@job.JobId" class="btn btn-info btn-sm">View Applications</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>


@section Scripts {
    <script>
        // TempData alerts
        @if (TempData["SuccessMessage"] != null)
        {
                <text>alert("@TempData["SuccessMessage"]");</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
                <text>alert("@TempData["ErrorMessage"]");</text>
        }

        // Client-side table search
        const searchInput = document.getElementById('searchInput');
        searchInput.addEventListener('keyup', function () {
            const filter = this.value.trim().toLowerCase();
            const rows = document.querySelectorAll('table tbody tr');

            rows.forEach(row => {
                // Skip rows like "No jobs found" which don't have 4 cells
                if (row.cells.length < 4) return;

                const title = row.cells[0].innerText.toLowerCase();
                const location = row.cells[1].innerText.toLowerCase();
                const jobType = row.cells[2].innerText.toLowerCase();
                const deadline = row.cells[3].innerText.toLowerCase();

                const match = title.includes(filter) ||
                              location.includes(filter) ||
                              jobType.includes(filter) ||
                              deadline.includes(filter);

                row.style.display = match ? '' : 'none';
            });
        });
    </script>
}

