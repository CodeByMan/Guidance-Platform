@model IEnumerable<CareerGuidance.Models.Job>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Jobs";
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4 bg-light">
    <div class="container-xl">
        <!-- Page Title -->
        <div class="mb-2">
            <h3 class="text-info text-center">Manage Jobs</h3>
        </div>

        <!-- Header with total count and search -->
        <div class="mb-4">
            <!-- Top row: Button left, Total Jobs right -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <a asp-action="ClosedJobs" class="btn btn-info text-white">View Closed Jobs</a>
                <h5 class="mb-0">
                    Total Jobs: <span id="totalCount" class="badge bg-info">@Model.Count()</span>
                </h5>
            </div>

            <!-- Bottom row: Full-width search bar -->
            <div class="input-group">
                <input type="text" id="searchInput" class="form-control" placeholder="Search by title, location, job type, deadline..." />
                <span class="input-group-text bg-info text-white">
                    <i class="bi bi-search"></i>
                </span>
            </div>
        </div>


        <hr>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th>Title</th>
                            <th>Location</th>
                            <th>Job Type</th>
                            <th>Deadline</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-3">No jobs found.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var job in Model)
                            {
                                <tr>
                                    <td>@job.Title</td>
                                    <td>@job.Location</td>
                                    <td>@job.JobType</td>
                                    <td>@job.Deadline.ToString("yyyy-MM-dd")</td>
                                    <td class="d-flex flex-wrap gap-1">
                                        <a asp-action="Details" asp-route-id="@job.JobId" class="btn btn-secondary btn-sm">Details</a>
                                        <a asp-action="Edit" asp-route-id="@job.JobId" class="btn btn-warning btn-sm">Edit</a>
                                        <form asp-action="Delete" asp-route-id="@job.JobId" method="post" style="display:inline" onsubmit="return confirm('Are you sure?');">
                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                        </form>
                                        <a asp-controller="AdminApplications" asp-action="JobApplicationsByJob" asp-route-jobId="@job.JobId" class="btn btn-info btn-sm">View Applications</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // TempData alerts
        @if (TempData["SuccessMessage"] != null)
        {
                <text>alert("@TempData["SuccessMessage"]");</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
                <text>alert("@TempData["ErrorMessage"]");</text>
        }

        // Client-side table search
        const searchInput = document.getElementById('searchInput');
        searchInput.addEventListener('keyup', function () {
            const filter = this.value.trim().toLowerCase();
            const rows = document.querySelectorAll('table tbody tr');

            rows.forEach(row => {
                // Skip rows like "No jobs found" which don't have 4 cells
                if (row.cells.length < 4) return;

                const title = row.cells[0].innerText.toLowerCase();
                const location = row.cells[1].innerText.toLowerCase();
                const jobType = row.cells[2].innerText.toLowerCase();
                const deadline = row.cells[3].innerText.toLowerCase();

                const match = title.includes(filter) ||
                              location.includes(filter) ||
                              jobType.includes(filter) ||
                              deadline.includes(filter);

                row.style.display = match ? '' : 'none';
            });
        });
    </script>
}

