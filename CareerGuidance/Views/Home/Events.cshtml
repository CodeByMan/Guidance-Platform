@model List<CareerGuidance.Models.Event>
@using System.Security.Claims
@{
    ViewData["Title"] = "Events";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";

    bool isLoggedIn = User.Identity.IsAuthenticated;
    string userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var appliedEventIds = ViewBag.AppliedEventIds as List<int> ?? new List<int>();
    var groupedEvents = Model?.GroupBy(e => e.Type).ToList();
}

<div class="page-title" data-aos="fade">
    <div class="heading">
        <div class="container">
            <div class="row justify-content-center text-center">
                <div class="col-lg-8">
                    <h1>Events</h1>
                </div>
            </div>
        </div>
    </div>
    <nav class="breadcrumbs">
        <div class="container">
            <ol>
                <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                <li class="current">Events</li>
            </ol>
        </div>
    </nav>
</div>

<section id="events" class="events section">
    <div class="container" data-aos="fade-up">

        @if (groupedEvents != null && groupedEvents.Any())
        {
            @foreach (var group in groupedEvents)
            {
                <div class="text-center mb-5">
                    <h2 class="mb-1">@group.Key</h2>
                    <hr class="mx-auto" style="width: 60px; height: 3px; background-color: #2B9BFF; border: none;">
                </div>

                <div class="row g-4">
                    @foreach (var item in group)
                    {
                        <div class="col-md-6 d-flex">
                            <div class="card w-100 d-flex flex-column h-100">
                                <img src="~/images/@item.ImageSrc" alt="event image" class="card-img-top" style="height:200px; object-fit:cover;">

                                <div class="card-body d-flex flex-column p-3">
                                    <h5 class="card-title text-center mb-1">
                                        <a href="#" class="text-decoration-none text-dark">@item.Title</a>
                                    </h5>
                                    <p class="fst-italic text-center mb-1">@item.DateTimeText</p>
                                    <p class="card-text mb-2 text-center">@item.Description</p>
                                    <p class="text-center">
                                        <strong>@(item.Type == "Conference" ? "Venue" : "Online Link"):</strong> @item.Venue
                                    </p>

                                    <div class="mt-auto text-center">
                                        @if (!isLoggedIn)
                                        {
                                            <a href="/Auth/Login" class="btn btn-secondary btn-sm">Login to Apply</a>
                                        }
                                        else if (userRole == "User")
                                        {
                                            if (appliedEventIds.Contains(item.EventId))
                                            {
                                                <button class="btn btn-secondary btn-sm" disabled>Already Applied</button>
                                            }
                                            else
                                            {
                                                <form asp-controller="AdminApplications" asp-action="ApplyRequest" method="post" onsubmit="return confirm('Are you sure you want to apply for this event?');">
                                                    <input type="hidden" name="eventId" value="@item.EventId" />
                                                    <button type="submit" class="btn btn-secondary btn-sm">Apply</button>
                                                </form>
                                            }
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning mb-0">Only students can apply.</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p>No events found.</p>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        @if (TempData["msg"] != null)
        {
                <text>alert('@TempData["msg"]');</text>
        }
    </script>
}
