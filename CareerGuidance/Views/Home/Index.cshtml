@model IEnumerable<CareerGuidance.Models.Course>
@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";  // Adjust the layout path as needed
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section id="hero" class="hero section dark-background">
    <img src="~/img/hero_bg.jpg" alt="" data-aos="fade-in">

    <div class="container">
        <h2 data-aos="fade-up" data-aos-delay="100">
            Guiding Your Career,<br>Shaping Your Future
        </h2>
        <p data-aos="fade-up" data-aos-delay="200">
            Connect with mentors, explore courses,<br> attend events, and achieve your career goals.
        </p>
        <div class="d-flex mt-4" data-aos="fade-up" data-aos-delay="300">
            <a class="btn-get-started" asp-controller="Auth" asp-action="Login">
              Get Started
            </a>
        </div>
    </div>

</section>
<!-- /Hero Section -->

<!-- About Section -->
<section id="about" class="about section">

    <div class="container">

        <div class="row gy-4">

            <div class="col-lg-6 order-1 order-lg-2" data-aos="fade-up" data-aos-delay="100">
                <img src="~/img/about_10.jpg" class="img-fluid" alt="Career Guidance">
            </div>

            <div class="col-lg-6 order-2 order-lg-1 content" data-aos="fade-up" data-aos-delay="200">
    <h3>Learn. Connect. Succeed.</h3>
    <p class="fst-italic">
        Unlock your career potential with guidance from experts, interactive courses, webinars, and personalized counseling.
    </p>
    <ul>
        <li><i class="bi bi-check-circle"></i> <span>Gain insights from experienced career mentors across industries.</span></li>
        <li><i class="bi bi-check-circle"></i> <span>Participate in interactive group sessions for peer learning.</span></li>
        <li><i class="bi bi-check-circle"></i> <span>Receive personalized counseling to identify your strengths.</span></li>
        <li><i class="bi bi-check-circle"></i> <span>Access curated courses, live webinars, and skill-building events.</span></li>
        <li><i class="bi bi-check-circle"></i> <span>Stay updated with the latest industry trends and opportunities.</span></li>
    </ul>
    <a asp-controller="Home" asp-action="Mentors" class="read-more">
        <span>Connect With Mentors</span><i class="bi bi-arrow-right"></i>
    </a>
</div>

        </div>

    </div>

</section><!-- /About Section -->

<!-- Counts Section -->
<section id="counts" class="section counts light-background">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row gy-4">

            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="@ViewBag.StudentsCount" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Students</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="@ViewBag.CoursesCount" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Courses</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="@ViewBag.EventsCount" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Events</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="@ViewBag.MentorsCount" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Trainers</p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Features Section -->
