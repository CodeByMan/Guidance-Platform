                </div>
            </div>

            <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="features-item">
                    <i class="bi bi-blockquote-right" style="color: #5578ff;"></i>
                    <h3><a asp-controller="Home" asp-action="Courses" class="stretched-link">Blockchain</a></h3>
                </div>
            </div>

            <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="features-item">
                    <i class="bi bi-cloud" style="color: #e80368;"></i>
                    <h3><a asp-controller="Home" asp-action="Courses" class="stretched-link">Cloud Computing</a></h3>
                </div>
            </div>

            <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="400">
                <div class="features-item">
                    <i class="bi bi-shield-lock" style="color: #e361ff;"></i>
                    <h3><a asp-controller="Home" asp-action="Courses" class="stretched-link">Cybersecurity</a></h3>
                </div>
            </div>

            <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="500">
                <div class="features-item">
                    <i class="bi bi-bar-chart" style="color: #47aeff;"></i>
                    <h3><a asp-controller="Home" asp-action="Courses" class="stretched-link">Data Science</a></h3>
                </div>
            </div>

            <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="600">
                <div class="features-item">
                    <i class="bi bi-database" style="color: #ffa76e;"></i>
                    <h3><a asp-controller="Home" asp-action="Courses" class="stretched-link">Database</a></h3>
                </div>
            </div>

            <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="700">
                <div class="features-item">
                    <i class="bi bi-gear" style="color: #11dbcf;"></i>
                    <h3><a asp-controller="Home" asp-action="Courses" class="stretched-link">DevOps</a></h3>
                </div>
            </div>

            <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="800">
                <div class="features-item">
                    <i class="bi bi-controller" style="color: #4233ff;"></i>
                    <h3><a asp-controller="Home" asp-action="Courses" class="stretched-link">Game Development</a></h3>
                </div>
            </div>

            <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="900">
                <div class="features-item">
                    <i class="bi bi-wifi" style="color: #b2904f;"></i>
                    <h3><a asp-controller="Home" asp-action="Courses" class="stretched-link">IoT</a></h3>
                </div>
            </div>

            <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="1000">
                <div class="features-item">
                    <i class="bi bi-phone" style="color: #b20969;"></i>
                    <h3><a asp-controller="Home" asp-action="Courses" class="stretched-link">Mobile Development</a></h3>
                </div>
            </div>

            <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="1100">
                <div class="features-item">
                    <i class="bi bi-diagram-3" style="color: #ff5828;"></i>
                    <h3><a asp-controller="Home" asp-action="Courses" class="stretched-link">Networking</a></h3>
                </div>
            </div>

            <div class="col-lg-3 col-md-4" data-aos="fade-up" data-aos-delay="1200">
                <div class="features-item">
                    <i class="bi bi-browser-edge" style="color: #29cc61;"></i>
                    <h3><a asp-controller="Home" asp-action="Courses" class="stretched-link">Web Development</a></h3>
                </div>
            </div>

        </div>

    </div>

</section>
<!-- /Features Section -->

<!-- Courses Section -->
<section id="courses" class="courses section py-5">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Courses</h2>
        <p>Popular Courses</p>
    </div>

    <div class="container">
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var course in Model)
                {
                    <div class="col-lg-3 col-md-6 col-sm-6"
                         data-title="@(course.Title.ToLower())"
                         data-category="@(course.Category.ToLower())"
                         data-trainer="@(course.TrainerName.ToLower())">

                        <div class="card h-100 shadow-sm position-relative d-flex flex-column">

                            @if (!string.IsNullOrEmpty(course.ImageUrl))
                            {
                                <div class="position-relative">
                                    <img src="@course.ImageUrl"
                                         class="card-img-top img-fluid"
                                         style="height:180px; object-fit:cover;"
                                         alt="Course Image" />

                                    <span class="badge bg-secondary position-absolute top-0 end-0 m-2">
                                        @course.Fee
                                    </span>
                                </div>
                            }

                            <div class="card-body d-flex flex-column flex-grow-1">
                                <p class="text-muted mb-1">@course.Category</p>
                                <h6 class="card-title fw-bold">@course.Title</h6>
                                <hr class="my-2" />

                                <div class="d-flex align-items-center mb-3">
                                    @if (!string.IsNullOrEmpty(course.TrainerProfileImageUrl))
                                    {
                                        <img src="@course.TrainerProfileImageUrl"
                                             alt="Trainer Image"
                                             class="rounded-circle me-2"
                                             style="width:40px; height:40px; object-fit:cover;" />
                                    }
                                    <div class="small text-truncate">
                                        <strong>Trainer:</strong><br> @course.TrainerName
                                    </div>
                                </div>

                                <a asp-controller="Home"
                                   asp-action="CourseDetails"
                                   asp-route-id="@course.CourseId"
                                   class="btn btn-secondary w-100 mt-auto">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p class="text-muted">No Courses found.</p>
                </div>
            }
        </div>
    </div>
</section>
<!-- /Courses Section -->

<!-- Mentors Section -->
<section id="trainers-index" class="section trainers-index py-5">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Mentors</h2>
        <p>Popular Mentors</p>
    </div>

    <div class="container">
        <div class="row justify-content-center g-4">
            @{
                var mentors = ViewBag.Mentors as List<dynamic>;
                int delay = 100;
            }

            @if (mentors != null && mentors.Count > 0)
            {
                foreach (var m in mentors)
                {
                    <div class="col-lg-3 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="@delay">
                        <div class="card h-100 border-0 shadow-sm text-center">
                            <img src="~/images/users/@(m.ImagePath ?? "user.png")"
                                 class="card-img-top img-fluid rounded-top"
                                 alt="@m.Username"
                                 style="height: 250px; object-fit: cover; object-position: center;">
                            
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="card-title mb-1">@m.Username</h5>
                                    <p class="card-text text-muted small mb-3">@m.Degree</p>
                                </div>
                                <a href="@Url.Action("Mentors", "Home")"
                                   class="btn btn-outline-secondary btn-sm rounded-pill px-3 mt-auto">
                                   View Details
                                </a>
                            </div>
                        </div>
                    </div>
                    delay += 100;
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p class="text-muted">No mentors found.</p>
                </div>
            }
        </div>
    </div>
</section>
<!-- /Mentors Section -->

<!-- Why Us Section -->
<section id="why-us" class="section why-us">

    <div class="container">

        <div class="row gy-4">

            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="why-box">
                    <h3>Why Choose CareerGuidance?</h3>
                    <p>
                        We provide personalized mentorship, expert-led courses, and interactive events to help you achieve your career goals faster. Join a community that supports your growth every step of the way.
                    </p>
                    <div class="text-center">
                        <a asp-controller="Home" asp-action="Contact" class="more-btn">
                            <span>Ask Us More</span> <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>
            </div><!-- End Why Box -->

            <div class="col-lg-8 d-flex align-items-stretch">
                <div class="row gy-4" data-aos="fade-up" data-aos-delay="200">

                    <div class="col-xl-4">
                        <div class="icon-box d-flex flex-column justify-content-center align-items-center">
                            <i class="bi bi-person-lines-fill"></i>
                            <h4>Expert Mentorship</h4>
                            <p>Connect with experienced mentors to guide your career path and decisions.</p>
                        </div>
                    </div><!-- End Icon Box -->

                    <div class="col-xl-4" data-aos="fade-up" data-aos-delay="300">
                        <div class="icon-box d-flex flex-column justify-content-center align-items-center">
                            <i class="bi bi-journal-bookmark"></i>
                            <h4>Courses & Webinars</h4>
                            <p>Access curated courses and live webinars to build skills and knowledge.</p>
                        </div>
                    </div><!-- End Icon Box -->

                    <div class="col-xl-4" data-aos="fade-up" data-aos-delay="400">
                        <div class="icon-box d-flex flex-column justify-content-center align-items-center">
                            <i class="bi bi-calendar-event"></i>
                            <h4>Events & Group Counseling</h4>
                            <p>Participate in events, workshops, and group counseling sessions for growth.</p>
                        </div>
                    </div><!-- End Icon Box -->

                </div>
            </div>

        </div>

    </div>

</section>
<!-- /Why Us Section -->

<!-- Testimonials Section -->
<section id="testimonials" class="testimonials section">
  <div class="container section-title" data-aos="fade-up">
    <h2>Testimonials</h2>
    <p>What are they saying</p>
  </div>

  <div class="container" data-aos="fade-up" data-aos-delay="100">
    <div class="swiper init-swiper">
      <script type="application/json" class="swiper-config">
      {
        "loop": true,
        "speed": 600,
        "autoplay": { "delay": 5000 },
        "slidesPerView": "auto",
        "pagination": { "el": ".swiper-pagination", "type": "bullets", "clickable": true },
        "breakpoints": {
          "320": { "slidesPerView": 1, "spaceBetween": 40 },
          "1200": { "slidesPerView": 2, "spaceBetween": 20 }
        }
      }
      </script>

      <div class="swiper-wrapper">
        @{
            var testimonials = ViewBag.Testimonials as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
        }

        @foreach (var achievement in testimonials)
        {
            <div class="swiper-slide">
                <div class="testimonial-wrap">
                    <div class="testimonial-item">
                        <img src="@achievement.PhotoUrl" class="testimonial-img" alt="@achievement.FullName" />
                        <h3>@achievement.FullName</h3>
                        <h4>@(!string.IsNullOrEmpty(achievement.Position) ? achievement.Position : achievement.Organization)</h4>
                        <div class="stars">
                            @for (int i = 0; i < 5; i++)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                        </div>
                        <p>
                            <i class="bi bi-quote quote-icon-left"></i>
                            <span>@achievement.TestimonialText</span>
                            <i class="bi bi-quote quote-icon-right"></i>
                        </p>
                    </div>
                </div>
            </div>
        }

        @if (!testimonials.Any())
        {
            <div class="col-12 text-center">
                <p>No testimonials found.</p>
            </div>
        }
      </div>

      <div class="swiper-pagination"></div>
    </div>
  </div>
</section>
<!-- /Testimonials Section -->
