@model CareerGuidance.Models.Achievement

@{
    ViewData["Title"] = "Achievement Details";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<div class="page-title" data-aos="fade">
    <div class="heading">
        <div class="container">
            <div class="row d-flex justify-content-center text-center">
                <div class="col-lg-8">
                    <h1 class="fw-bold text-uppercase mb-3">@Model.FullName</h1>
                    <p class="lead  mb-0">
                        @Model.Position
                        @if (!string.IsNullOrEmpty(Model.Organization))
                        {
                            <text>at @Model.Organization</text>
                        }
                    </p>
                    <p class="small mt-1">
                        <i class="bi bi-geo-alt"></i> @Model.City
                    </p>
                </div>
            </div>
        </div>
    </div>

    <nav class="breadcrumbs">
        <div class="container">
            <ol>
                <li><a href="@Url.Action("Achievements", "Home")">Success Stories</a></li>
                <li class="current">Story Detail</li>
            </ol>
        </div>
    </nav>
</div>

<!-- Story Section -->
<div class="container my-5">
    <div class="row align-items-center g-5">
        <!-- Left: Image -->
        <div class="col-lg-5" data-aos="fade-right">
            <div class="card border-0 shadow-sm overflow-hidden rounded-4">
                <img src="@Model.PhotoUrl"
                     alt="@Model.FullName"
                     class="img-fluid w-100"
                     style="object-fit: cover; height: 400px;">
            </div>
        </div>

        <!-- Right: Info -->
        <div class="col-lg-7" data-aos="fade-left">
            <div class="p-3 p-md-0">
                <h2 class="fw-semibold mb-3 text-secondary">About the Achievement</h2>
                <p class="text-muted lh-lg">@Model.Description</p>
            </div>
        </div>
    </div>

    <!-- Inspirational Quote or Highlight -->
    <div class="mt-5 p-5 rounded-4 shadow-sm text-center" style="background-color: #DBECFF" data-aos="fade-up">
        <blockquote class="blockquote mb-0">
            <p class="fs-5 fst-italic text-secondary">
                “Success is not just reaching the destination, but inspiring others to begin their journey.”
            </p>
            <footer class="blockquote-footer mt-2">
                CareerGuidance Community
            </footer>
        </blockquote>
    </div>
</div>

<!-- Optional: Related Achievements -->
<section class="py-5 bg-white border-top mt-5">
    <div class="container text-center" data-aos="fade-up">
        <h3 class="fw-bold mb-4">Other Inspiring Achievements</h3>
        <p class="text-muted mb-5">Discover more stories of determination and secondary.</p>
        <a asp-action="Achievements" class="btn btn-secondary px-4 py-2 rounded-pill">
            Explore More <i class="bi bi-arrow-right-short"></i>
        </a>
    </div>
</section>
