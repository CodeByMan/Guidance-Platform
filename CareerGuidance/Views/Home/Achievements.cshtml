@model IEnumerable<CareerGuidance.Models.Achievement>

@{
    ViewData["Title"] = "Achievements";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<!-- Page Title -->
<div class="page-title" data-aos="fade">
    <div class="heading">
        <div class="container">
            <div class="row d-flex justify-content-center text-center">
                <div class="col-lg-8">
                    <h1>Success Stories</h1>
                    <p class="mb-0">
                        Be inspired by individuals who have achieved their career goals with our guidance and mentorship.
                    </p>
                </div>
            </div>
        </div>
    </div>
    <nav class="breadcrumbs">
        <div class="container">
            <ol>
                <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                <li class="current">Success Stories</li>
            </ol>
        </div>
    </nav>
</div>
<!-- End Page Title -->
<!-- Achievements Section -->
<section id="achievements" class="events section">
    <div class="container" data-aos="fade-up">

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <p>No achievements available at the moment. Check back soon!</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var achievement in Model)
                {
                    <div class="col-12 col-md-4 d-flex align-items-stretch">
                        <div class="card shadow-sm w-100">
                            <!-- Card Image -->
                            <div class="card-img">
                                <img src="@achievement.PhotoUrl" alt="@achievement.FullName" class="img-fluid w-100 rounded-top">
                            </div>

                            <!-- Card Body -->
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title text-center mb-1">
                                    <a asp-action="AchievementDetails" asp-route-id="@achievement.AchievementId" class="text-decoration-none text-dark">
                                        @achievement.FullName
                                    </a>
                                </h5>

                                @if (!string.IsNullOrEmpty(achievement.Position))
                                {
                                    <div class="text-center text-muted small mb-2">
                                        @achievement.Position
                                    </div>
                                }

                                @* Optional description (uncomment if needed) *@
                                @* 
                                @if (!string.IsNullOrEmpty(achievement.Description))
                                {
                                    <p class="card-text text-center mb-2">@achievement.Description</p>
                                }
                                *@

                                <!-- Button -->
                                <div class="mt-auto text-center pt-2">
                                    <a asp-action="AchievementDetails"
                                       asp-route-id="@achievement.AchievementId"
                                       class="btn btn-secondary btn-sm px-3">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section><!-- /Achievements Section -->

<style>
    /* Reduce spacing in card titles and text */
    .card-body h5 {
        margin-bottom: 0.25rem;
    }

    .card-body p,
    .card-body .small {
        margin: 0.25rem 0;
    }

    /* Card hover effect */
    .card:hover {
        transform: translateY(-3px);
        transition: transform 0.3s ease;
    }

    /* Optional: Card shadow and rounded corners */
    .card {
        border-radius: 8px;
    }
</style>
