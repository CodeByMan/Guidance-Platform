@{
    ViewData["Title"] = "Mentors";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var mentors = ViewBag.Mentors as List<CareerGuidance.Models.User>;

    // Count mentors with RoleId = 2
    var totalMentors = mentors?.Count(m => m.RoleId == 2) ?? 0;
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4 bg-light">
    <div class="container-xl">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="text-info">Mentors</h3>
        </div>

        <!-- Header with total count and search -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="badge bg-info fs-6 mb-0">
                    Total Mentors: @totalMentors
                </h5>
            </div>

            <div class="input-group w-50">
                <input type="text" id="searchInput" class="form-control" placeholder="Search by title, category, trainer, fee..." />
                <span class="input-group-text bg-info text-white">
                    <i class="bi bi-search"></i>
                </span>
            </div>
        </div>
        <hr>

        @if (mentors == null || !mentors.Any())
        {
            <div class="alert alert-info text-center">
                No mentors found.
            </div>
        }
        else
        {
            <!-- Add id to your table for easy selection -->
            <div class="table-responsive">
                <table id="mentorsTable" class="table table-bordered align-middle text-center">
                    <thead class="table">
                        <tr>
                            <th scope="col" style="background-color: #2B9BFF !important; color: white !important;">Id</th>
                            <th scope="col" style="background-color: #2B9BFF !important; color: white !important;">Username</th>
                            <th scope="col" style="background-color: #2B9BFF !important; color: white !important;">Email</th>
                            <th scope="col" style="background-color: #2B9BFF !important; color: white !important;">Image</th>
                            <th scope="col" style="background-color: #2B9BFF !important; color: white !important;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mentor in mentors.Where(m => m.RoleId == 2))
                        {
                            <tr>
                                <td>@mentor.UserId</td>
                                <td>@mentor.Username</td>
                                <td>@mentor.Email</td>
                                <td>
                                    <img src="~/images/users/@mentor.Imagepath" alt="Profile" class="rounded-circle" style="width:60px; height:60px; object-fit:cover;">
                                </td>
                                <td>
                                    <form asp-action="DeleteConfirmed" asp-controller="Admin" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@mentor.UserId" />
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this mentor permanently?')">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('searchInput');
        const table = document.getElementById('mentorsTable');
        const tbody = table.getElementsByTagName('tbody')[0];

        searchInput.addEventListener('input', () => {
            const filter = searchInput.value.toLowerCase();

            // Loop through all table rows
            Array.from(tbody.rows).forEach(row => {
                const userId = row.cells[0].textContent.toLowerCase();
                const username = row.cells[1].textContent.toLowerCase();
                const email = row.cells[2].textContent.toLowerCase();

                if (
                    userId.includes(filter) ||
                    username.includes(filter) ||
                    email.includes(filter)
                ) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    });
</script>
}