@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var users = ViewBag.RegularUsers as List<CareerGuidance.Models.User>;

    // Count users with RoleId = 3
    var totalUsers = users?.Count(u => u.RoleId == 3) ?? 0;
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4 bg-light">
    <div class="container-xl">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="text-info">Students</h3>
        </div>

        <!-- Header with total count and search -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="badge bg-info fs-6 mb-0">
                    Total Users: @totalUsers
                </h5>
            </div>

            <div class="input-group w-50">
                <input type="text" id="searchInput" class="form-control" placeholder="Search by title, category, trainer, fee..." />
                <span class="input-group-text bg-info text-white">
                    <i class="bi bi-search"></i>
                </span>
            </div>
        </div>
        <hr>

        @if (users == null || !users.Any())
        {
            <div class="alert alert-info text-center">
                No users found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="usersTable" class="table table-bordered align-middle text-center">
                    <thead class="table">
                        <tr>
                            <th scope="col" style="background-color: #2B9BFF !important; color: white !important;">Id</th>
                            <th scope="col" style="background-color: #2B9BFF !important; color: white !important;">Username</th>
                            <th scope="col" style="background-color: #2B9BFF !important; color: white !important;">Email</th>
                            <th scope="col" style="background-color: #2B9BFF !important; color: white !important;">Image</th>
                            <th scope="col" style="background-color: #2B9BFF !important; color: white !important;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users.Where(m => m.RoleId == 3))
                        {
                            <tr>
                                <td>@user.UserId</td>
                                <td>@user.Username</td>
                                <td>@user.Email</td>
                                <td>
                                    <img src="~/images/users/@user.Imagepath" alt="Profile" class="rounded-circle" style="width:60px; height:60px; object-fit:cover;">
                                </td>
                                <td>
                                    <form asp-action="DeleteConfirmed" asp-controller="Admin" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@user.UserId" />
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this mentor permanently?')">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('searchInput');
            const table = document.getElementById('usersTable');
            const tbody = table.getElementsByTagName('tbody')[0];

            searchInput.addEventListener('input', () => {
                const filter = searchInput.value.toLowerCase();

                // Loop through all table rows
                Array.from(tbody.rows).forEach(row => {
                    const userId = row.cells[0].textContent.toLowerCase();
                    const username = row.cells[1].textContent.toLowerCase();
                    const email = row.cells[2].textContent.toLowerCase();

                    if (
                        userId.includes(filter) ||
                        username.includes(filter) ||
                        email.includes(filter)
                    ) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        });
    </script>
}
