@model CareerGuidance.Models.Resume
@{
    Layout = "_PdfLayout";
}

<style>
    .header {
        text-align: center;
        border-bottom: 2px solid #444;
        padding-bottom: 20px;
        margin-bottom: 30px;
        color: #222;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 14px;
    }

        .header h1 {
            font-size: 28px;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .header .title {
            font-size: 16px;
            color: #666;
            margin-top: 5px;
        }

    .contact-info {
        margin-top: 10px;
        font-size: 13px;
        color: #555;
    }

        .contact-info span {
            display: inline-block;
            margin: 0 10px;
        }

    h2.section-title {
        font-size: 16px;
        color: #333;
        border-bottom: 1px solid #ccc;
        padding-bottom: 4px;
        margin-top: 35px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .section p, .section ul {
        margin: 10px 0 0;
        font-size: 14px;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    .section ul {
        padding-left: 20px;
        list-style-type: disc;
    }

        .section ul li {
            margin-bottom: 5px;
        }
</style>

<div class="header">
    <h1>@Model.FullName</h1>
    <div class="title">Professional Resume</div>
    <div class="contact-info">
        <p>@Model.Email | @Model.Phone</p>
    </div>
</div>

<div class="section">
    <h2 class="section-title">Objective:</h2>
    <p>@Model.Objective</p>
</div>

<div class="section">
    <h2 class="section-title">Skills:</h2>
    <ul>
        @foreach (var skill in (Model.Skills ?? "").Split(new[] { ',', '\n' }, StringSplitOptions.RemoveEmptyEntries))
        {
            <li>@skill.Trim()</li>
        }
    </ul>
</div>

<div class="section">
    <h2 class="section-title">Experience:</h2>
    <p>@Model.Experience</p>
</div>

<div class="section">
    <h2 class="section-title">Education:</h2>
    <p>@Model.Education</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Certifications))
{
    <div class="section">
        <h2 class="section-title">Certifications:</h2>
        <p>@Model.Certifications</p>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.Projects))
{
    <div class="section">
        <h2 class="section-title">Projects:</h2>
        <p>@Model.Projects</p>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.Languages))
{
    <div class="section">
        <h2 class="section-title">Languages:</h2>
        <ul>
            @foreach (var lang in Model.Languages.Split(new[] { ',', '\n' }, StringSplitOptions.RemoveEmptyEntries))
            {
                <li>@lang.Trim()</li>
            }
        </ul>
    </div>
}
