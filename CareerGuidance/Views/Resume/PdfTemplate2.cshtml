@model CareerGuidance.Models.Resume
@{
    Layout = "_PdfLayout";
}

<style>
    .resume-container {
        width: 900px;
        margin: 0 auto;
        border: 1px solid #ddd;
        box-shadow: 0 0 10px rgba(0,0,0,0.05);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 14px;
        color: #333;
        padding: 0;
    }

    .resume-table {
        width: 100%;
        border-collapse: collapse;
    }

    .sidebar {
        width: 280px;
        background-color: #2c3e50;
        color: #ecf0f1;
        vertical-align: top;
        padding: 30px 20px;
    }

        .sidebar h1 {
            font-size: 22px;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-align: center; /* Centered */
        }

        .sidebar p {
            font-size: 13px;
            margin: 4px 0;
        }

        .sidebar .resume-for {
            font-style: italic;
            font-size: 14px;
            margin-bottom: 15px;
            color: #bdc3c7;
            text-align: center; /* Centered */
        }

    .profile-img {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: 50%;
        margin: 0 auto 20px;
        display: block;
        border: 2px solid #ecf0f1;
    }

    .sidebar-section {
        margin-top: 25px;
    }

        .sidebar-section h2 {
            font-size: 14px;
            border-bottom: 1px solid #7f8c8d;
            padding-bottom: 5px;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

    .main {
        padding: 30px;
        vertical-align: top;
    }

        .main h2 {
            font-size: 16px;
            color: #2c3e50;
            text-transform: uppercase;
            border-bottom: 1px solid #bdc3c7;
            padding-bottom: 4px;
            margin-top: 25px;
            margin-bottom: 10px;
        }

        .main p {
            margin: 0 0 10px;
            line-height: 1.6;
            white-space: pre-wrap;
        }
</style>

<div class="resume-container">
    <table class="resume-table">
        <tr>
            <!-- Sidebar -->
            <td class="sidebar">
                @if (!string.IsNullOrEmpty(Model.ProfileImageFileName))
                {
                    <img class="profile-img" src="@Url.Content("~/images/profiles/" + Model.ProfileImageFileName)" alt="Profile Image" />
                }
                <h1>@Model.FullName</h1>
                <p class="resume-for">@Model.ResumeFor</p>

                <div class="sidebar-section">
                    <h2>Contact Info:</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <p><strong>Email:</strong> @Model.Email</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Phone))
                    {
                        <p><strong>Phone:</strong> @Model.Phone</p>
                    }
                </div>

                <div class="sidebar-section">
                    <h2>Skills:</h2>
                    <p>@Model.Skills</p>
                </div>

                <div class="sidebar-section">
                    <h2>Languages:</h2>
                    <p>@Model.Languages</p>
                </div>
            </td>

            <!-- Main Content -->
            <td class="main">
                <h2>Objective:</h2>
                <p>@Model.Objective</p>

                <h2>Experience:</h2>
                <p>@Model.Experience</p>

                <h2>Education:</h2>
                <p>@Model.Education</p>

                <h2>Certifications:</h2>
                <p>@Model.Certifications</p>

                <h2>Projects:</h2>
                <p>@Model.Projects</p>
            </td>
        </tr>
    </table>
</div>
