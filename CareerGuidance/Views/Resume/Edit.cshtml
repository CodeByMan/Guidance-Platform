@model CareerGuidance.Models.Resume

@{
    ViewData["Title"] = "Edit Resume";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4">
    <div class="container xl">

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

        <h2 class="mb-4">📄 @ViewData["Title"]</h2>

        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ResumeId" />

            <!-- Personal Information -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-info text-white">
                    <strong><i class="fa fa-user"></i> Personal Info</strong>
                </div>
                <div class="card-body row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label">👤 Full Name</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ResumeFor" class="form-label">🎯 Job Title</label>
                        <input asp-for="ResumeFor" class="form-control" />
                        <span asp-validation-for="ResumeFor" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">📧 Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">📞 Phone</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">🖼️ Profile Image</label>
                        <input type="file" name="ProfileImageFile" id="ProfileImageFile" accept="image/*" class="form-control" />
                        @if (!string.IsNullOrEmpty(Model.ProfileImageFileName))
                        {
                            <img class="profile-img" src="~/images/profiles/@Model.ProfileImageFileName" alt="Profile Image" class="img-thumbnail mt-2" style="max-width: 120px;" />
                        }
                        else
                        {
                            <img id="imgPreview" src="#" alt="Preview" class="img-thumbnail mt-2" style="display:none; max-width: 120px;" />
                        }
                    </div>
                </div>
            </div>

            <!-- Resume Content -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-info text-white">
                    <strong><i class="fa fa-file-alt"></i> Resume Content</strong>
                </div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <label asp-for="Objective" class="form-label">📝 Objective</label>
                        <textarea asp-for="Objective" class="form-control" rows="3" oninput="updateCharCount(this)"></textarea>
                        <small class="form-text text-muted char-count"></small>
                        <span asp-validation-for="Objective" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Skills" class="form-label">💡 Skills</label>
                        <textarea asp-for="Skills" class="form-control" rows="3" oninput="updateCharCount(this)"></textarea>
                        <small class="form-text text-muted char-count"></small>
                        <span asp-validation-for="Skills" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Experience" class="form-label">💼 Experience</label>
                        <textarea asp-for="Experience" class="form-control" rows="3" oninput="updateCharCount(this)"></textarea>
                        <small class="form-text text-muted char-count"></small>
                        <span asp-validation-for="Experience" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Education" class="form-label">🎓 Education</label>
                        <textarea asp-for="Education" class="form-control" rows="3" oninput="updateCharCount(this)"></textarea>
                        <small class="form-text text-muted char-count"></small>
                        <span asp-validation-for="Education" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Certifications" class="form-label">📜 Certifications</label>
                        <textarea asp-for="Certifications" class="form-control" rows="3" oninput="updateCharCount(this)"></textarea>
                        <small class="form-text text-muted char-count"></small>
                        <span asp-validation-for="Certifications" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Projects" class="form-label">🛠️ Projects</label>
                        <textarea asp-for="Projects" class="form-control" rows="3" oninput="updateCharCount(this)"></textarea>
                        <small class="form-text text-muted char-count"></small>
                        <span asp-validation-for="Projects" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Languages" class="form-label">🌐 Languages</label>
                        <textarea asp-for="Languages" class="form-control" rows="3" oninput="updateCharCount(this)"></textarea>
                        <small class="form-text text-muted char-count"></small>
                        <span asp-validation-for="Languages" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Template Selection -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-info text-white">
                    <strong><i class="fa fa-paint-brush"></i> Choose Template</strong>
                </div>
                <div class="card-body">
                    <label asp-for="SelectedTemplate" class="form-label">🎨 Resume Template</label>
                    <select asp-for="SelectedTemplate" class="form-select" id="templateSelect">
                        <option value="PdfTemplate" data-img-src="~/images/templates/template0.png">Basic Template</option>
                        <option value="PdfTemplate1" data-img-src="~/images/templates/template1.png">Modern Template</option>
                        <option value="PdfTemplate2" data-img-src="~/images/templates/template2.png">Sidebar Template</option>
                        <option value="PdfTemplate3" data-img-src="~/images/templates/template3.png">Clean-Minimal Template</option>
                    </select>

                    @* <div id="templatePreview" class="mt-3 text-center">
                        <img src="@(Model.SelectedTemplate switch {
                            "PdfTemplate1" => Url.Content("~/images/templates/template1.png"),
                            "PdfTemplate2" => Url.Content("~/images/templates/template2.png"),
                            "PdfTemplate3" => Url.Content("~/images/templates/template3.png"),
                            _ => Url.Content("~/images/templates/template.png")
                        })" alt="Template Preview" class="img-thumbnail" style="max-width: 300px;" />
                    </div> *@
                </div>
            </div>

            <!-- Submit Button -->
            <div class="text-center">
                <button type="submit" class="btn btn-info">Save Changes</button>
            </div>
        </form>
    
</div>
</<div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const imgInput = document.getElementById('ProfileImageFile');
        const imgPreview = document.getElementById('imgPreview');

        imgInput.addEventListener('change', function () {
            const file = this.files[0];
            if (file && file.type.startsWith("image/")) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    imgPreview.src = e.target.result;
                    imgPreview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                imgPreview.style.display = 'none';
            }
        });

        document.getElementById('templateSelect').addEventListener('change', function () {
            const selectedOption = this.options[this.selectedIndex];
            const imgSrc = selectedOption.getAttribute('data-img-src');
            const preview = document.getElementById('templatePreview').querySelector('img');
            preview.src = imgSrc;
        });

        function updateCharCount(textarea) {
            const count = textarea.value.length;
            const counter = textarea.nextElementSibling;
            if (counter && counter.classList.contains('char-count')) {
                counter.innerText = `${count} characters`;
            }
        }

        // Initialize character counts on page load
        document.querySelectorAll('textarea').forEach(textarea => {
            updateCharCount(textarea);
        });
    </script>
}
