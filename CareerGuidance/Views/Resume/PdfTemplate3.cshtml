@model CareerGuidance.Models.Resume
@{
    Layout = "_PdfLayout";
}

<div class="resume-wrapper" style="max-width: 900px; margin: 40px auto; background: #fff; border-radius: 10px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #333;">
    <!-- Header -->
    <div class="header" style="background: #003366; color: #fff; padding: 30px;">
        <table style="width: 100%; border-collapse: collapse;">
            <tr>
                <td style="width: 130px; vertical-align: middle;">
                    @if (!string.IsNullOrEmpty(Model.ProfileImageFileName))
                    {
                        <img src="@Url.Content("~/images/profiles/" + Model.ProfileImageFileName)" alt="Profile Picture"
                             style="width: 120px; height: 120px; border-radius: 50%; border: 4px solid #fff; object-fit: cover;" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/120" alt="No Image"
                             style="width: 120px; height: 120px; border-radius: 50%; border: 4px solid #fff; object-fit: cover;" />
                    }
                </td>
                <td style="vertical-align: middle; padding-left: 25px; text-align: left;">
                    <h1 style="font-size: 2rem; margin: 0; font-weight: 600;">@Model.FullName</h1>
                    @if (!string.IsNullOrEmpty(Model.ResumeFor))
                    {
                        <p style="margin: 4px 0; opacity: 0.9;">@Model.ResumeFor</p>
                    }

                    <!-- Contact info beneath name and resumefor -->
                    @if (!string.IsNullOrWhiteSpace(Model.Email) || !string.IsNullOrWhiteSpace(Model.Phone))
                    {
                        <div style="margin-top: 10px; font-size: 0.95rem; opacity: 0.85;">
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <span>Email: <a href="mailto:@Model.Email" style="color: #cce6ff; text-decoration: underline;">@Model.Email</a></span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Email) && !string.IsNullOrWhiteSpace(Model.Phone))
                            {
                                <span style="margin: 0 8px;">|</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Phone))
                            {
                                <span>Phone: @Model.Phone</span>
                            }
                        </div>
                    }
                </td>
            </tr>
        </table>
    </div>

    <!-- Objective -->
    @if (!string.IsNullOrWhiteSpace(Model.Objective))
    {
        <div class="section" style="padding: 25px 40px; border-bottom: 1px solid #e0e0e0;">
            <h2 style="font-size: 1.3rem; color: #003366; margin-bottom: 15px; font-weight: 600; border-left: 4px solid #003366; padding-left: 10px;">Career Objective</h2>
            <p>@Model.Objective</p>
        </div>
    }

    <!-- Experience -->
    @if (!string.IsNullOrWhiteSpace(Model.Experience))
    {
        <div class="section" style="padding: 25px 40px; border-bottom: 1px solid #e0e0e0;">
            <h2 style="font-size: 1.3rem; color: #003366; margin-bottom: 15px; font-weight: 600; border-left: 4px solid #003366; padding-left: 10px;">Professional Experience</h2>
            <p>@Model.Experience</p>
        </div>
    }

    <!-- Education -->
    @if (!string.IsNullOrWhiteSpace(Model.Education))
    {
        <div class="section" style="padding: 25px 40px; border-bottom: 1px solid #e0e0e0;">
            <h2 style="font-size: 1.3rem; color: #003366; margin-bottom: 15px; font-weight: 600; border-left: 4px solid #003366; padding-left: 10px;">Education</h2>
            <p>@Model.Education</p>
        </div>
    }

    <!-- Certifications -->
    @if (!string.IsNullOrWhiteSpace(Model.Certifications))
    {
        <div class="section" style="padding: 25px 40px; border-bottom: 1px solid #e0e0e0;">
            <h2 style="font-size: 1.3rem; color: #003366; margin-bottom: 15px; font-weight: 600; border-left: 4px solid #003366; padding-left: 10px;">Certifications</h2>
            <p>@Model.Certifications</p>
        </div>
    }

    <!-- Projects -->
    @if (!string.IsNullOrWhiteSpace(Model.Projects))
    {
        <div class="section" style="padding: 25px 40px; border-bottom: 1px solid #e0e0e0;">
            <h2 style="font-size: 1.3rem; color: #003366; margin-bottom: 15px; font-weight: 600; border-left: 4px solid #003366; padding-left: 10px;">Projects</h2>
            <p>@Model.Projects</p>
        </div>
    }

    <!-- Skills -->
    @if (!string.IsNullOrWhiteSpace(Model.Skills))
    {
        <div class="section skills" style="padding: 25px 40px; border-bottom: 1px solid #e0e0e0;">
            <h2 style="font-size: 1.3rem; color: #003366; margin-bottom: 15px; font-weight: 600; border-left: 4px solid #003366; padding-left: 10px;">Skills</h2>
            @{
                var skills = Model.Skills.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim());
            }
            @foreach (var skill in skills)
            {
                <span style="background: #003366; color: #fff; padding: 6px 12px; border-radius: 20px; display: inline-block; margin: 5px 5px 0 0; font-size: 0.9rem;">@skill</span>
            }
        </div>
    }

    <!-- Languages -->
    @if (!string.IsNullOrWhiteSpace(Model.Languages))
    {
        <div class="section" style="padding: 25px 40px; border-bottom: 1px solid #e0e0e0;">
            <h2 style="font-size: 1.3rem; color: #003366; margin-bottom: 15px; font-weight: 600; border-left: 4px solid #003366; padding-left: 10px;">Languages</h2>
            <p>@Model.Languages</p>
        </div>
    }
</div>
