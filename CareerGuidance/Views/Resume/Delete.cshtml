@model CareerGuidance.Models.Resume

@{
    ViewData["Title"] = "Delete Resume";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4">
    <div class="container xl">


<h2>@ViewData["Title"]</h2>

<h3>Are you sure you want to delete this resume?</h3>

<div>
    <h4>@Model.FullName</h4>
    <dl class="row">
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Template</dt>
        <dd class="col-sm-10">@Model.SelectedTemplate</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ResumeId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>


</<div>
</div>