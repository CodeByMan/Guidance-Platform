<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="Portal - Bootstrap 5 Admin Dashboard Template For Developers" />
    <meta name="author" content="Xiaoying Riley at 3rd Wave Media" />
    <link rel="shortcut icon" href="~/images/logo.png" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <title>@ViewData["Title"] - CareerGuidance</title>

    <!-- FontAwesome JS-->
    <script defer src="~/plugins/fontawesome/js/all.min.js"></script>

    <!-- App CSS -->
    <link id="theme-style" rel="stylesheet" href="~/css/portal.css" />

    @RenderSection("Styles", required: false)
</head>
<body>

	<header class="app-header fixed-top">
		<div class="app-header-inner">
			<div class="container-fluid py-2">
				<div class="app-header-content">
					<div class="row justify-content-between align-items-center">

						<div class="col-auto">
							<a id="sidepanel-toggler" class="sidepanel-toggler d-inline-block d-xl-none" href="#">
								<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30" role="img"><title>Menu</title><path stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="2" d="M4 7h22M4 15h22M4 23h22"></path></svg>
							</a>
						</div><!--//col-->

						<div class="app-utilities col-auto">
							<div class="app-utility-item app-notifications-dropdown dropdown">
								<a class="dropdown-toggle no-toggle-arrow" id="notifications-dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false" title="Notifications">
									<svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-bell icon" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
										<path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2z" />
										<path fill-rule="evenodd" d="M8 1.918l-.797.161A4.002 4.002 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4.002 4.002 0 0 0-3.203-3.92L8 1.917zM14.22 12c.223.447.481.801.78 1H1c.299-.199.557-.553.78-1C2.68 10.2 3 6.88 3 6c0-2.42 1.72-4.44 4.005-4.901a1 1 0 1 1 1.99 0A5.002 5.002 0 0 1 13 6c0 .88.32 4.2 1.22 6z" />
									</svg>
									<span class="icon-badge">
										@((ViewBag.UpcomingExpirations as List<CareerGuidance.Models.SavedJob>)?.Count ?? 0)
									</span>
								</a>

								<div class="dropdown-menu p-0" aria-labelledby="notifications-dropdown-toggle">
									<div class="dropdown-menu-header p-3">
										<h5 class="dropdown-menu-title mb-0">Notifications</h5>
									</div>

									<div class="dropdown-menu-content">
										@* Saved Jobs Expiration Reminders *@
										@if (ViewBag.UpcomingExpirations != null && ((List<CareerGuidance.Models.SavedJob>)ViewBag.UpcomingExpirations).Count > 0)
										{
											foreach (var saved in (List<CareerGuidance.Models.SavedJob>)ViewBag.UpcomingExpirations)
											{
												<div class="item p-3">
													<div class="row gx-2 justify-content-between align-items-center">
														<div class="col-auto">
															<div class="app-icon-holder icon-holder-mono bg-warning text-white">
																<svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-exclamation-triangle" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
																	<path d="M7.938 2.016a.13.13 0 0 1 .125 0l6.857 11.856c.044.076.07.163.07.256a.5.5 0 0 1-.5.5H.51a.5.5 0 0 1-.5-.5.437.437 0 0 1 .07-.256L6.938 2.016a.13.13 0 0 1 .125 0zM8 4.5c-.28 0-.5.22-.5.5v3a.5.5 0 0 0 1 0v-3a.5.5 0 0 0-.5-.5zm.002 6a.498.498 0 1 0 0 1 .498.498 0 0 0 0-1z" />
																</svg>
															</div>
														</div>
														<div class="col">
															<div class="info">
																<div class="desc"><strong>@saved.Job.Title</strong> – Deadline: @saved.Job.Deadline.ToString("dd MMM yyyy")</div>
																<div class="meta text-warning">Expiring Soon</div>
															</div>
														</div>
													</div>
													<a class="link-mask" href="@Url.Action("JobDetails", "Home", new { id = saved.JobId })"></a>
												</div>
											}
										}
										else
										{
											<div class="item p-3 text-center text-muted">
												No new notifications.
											</div>
										}
									</div>

									<div class="dropdown-menu-footer p-2 text-center">
										<a href="@Url.Action("SavedJobs", "SavedJobs")">View all saved jobs</a>
									</div>
								</div>
							</div><!--//app-utility-item-->

							<div class="app-utility-item app-user-dropdown dropdown">
								<a class="dropdown-toggle" id="user-dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
									<img src="~/images/users/@(string.IsNullOrEmpty(ViewBag.ProfileImage) ? "user.png" : ViewBag.ProfileImage)" alt="user profile" width="40" height="40" style="border-radius: 50%;">
								</a>
								<ul class="dropdown-menu" aria-labelledby="user-dropdown-toggle">
									<li><a class="dropdown-item" href="@Url.Action("Index", "Home")">Home</a></li>
									<li><a class="dropdown-item" href="@Url.Action("Profile", "User")">Profile</a></li>
									<li><hr class="dropdown-divider"></li>
									<li><a class="dropdown-item" href="@Url.Action("Logout", "Auth")">Log Out</a></li>
								</ul>
							</div><!--//app-user-dropdown-->
						</div><!--//app-utilities-->
					</div><!--//row-->
				</div><!--//app-header-content-->
			</div><!--//container-fluid-->
		</div><!--//app-header-inner-->
		<div id="app-sidepanel" class="app-sidepanel">
			<div id="sidepanel-drop" class="sidepanel-drop"></div>
			<div class="sidepanel-inner d-flex flex-column">
				<a href="#" id="sidepanel-close" class="sidepanel-close d-xl-none">&times;</a>
				<div class="app-branding">
					<a class="app-logo" href="@Url.Action("Index", "User")"><img class="logo-icon me-2" src="~/images/logo.png" alt="logo"><span class="logo-text">Guidance</span></a>

				</div><!--//app-branding-->

				<nav id="app-nav-main" class="app-nav app-nav-main flex-grow-1">
					<ul class="app-menu list-unstyled accordion" id="menu-accordion">

						<li class="nav-item">
							<!--//Bootstrap Icons: https://icons.getbootstrap.com/ -->
							<a class="nav-link active" href="@Url.Action("Index", "User")">
								<span class="nav-icon">
									<svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-house-door" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
										<path fill-rule="evenodd" d="M7.646 1.146a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 .146.354v7a.5.5 0 0 1-.5.5H9.5a.5.5 0 0 1-.5-.5v-4H7v4a.5.5 0 0 1-.5.5H2a.5.5 0 0 1-.5-.5v-7a.5.5 0 0 1 .146-.354l6-6zM2.5 7.707V14H6v-4a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5v4h3.5V7.707L8 2.207l-5.5 5.5z" />
										<path fill-rule="evenodd" d="M13 2.5V6l-2-2V2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5z" />
									</svg>
								</span>
								<span class="nav-link-text">Dashboard</span>
							</a><!--//nav-link-->
						</li><!--//nav-item-->

						<li class="nav-item has-submenu">
							<a class="nav-link submenu-toggle" href="#" data-bs-toggle="collapse" data-bs-target="#submenu-2" aria-expanded="false" aria-controls="submenu-2">
								<span class="nav-icon">
									<i class="bi bi-bullseye"></i> <!-- Goal-related icon -->
								</span>
								<span class="nav-link-text">Goals</span>
								<span class="submenu-arrow"> <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-chevron-down" fill="currentColor" xmlns="http://www.w3.org/2000/svg"> <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z" /> </svg> </span>
							</a>
							<div id="submenu-2" class="collapse submenu submenu-2" data-bs-parent="#menu-accordion">
								<ul class="submenu-list list-unstyled">
									<li class="submenu-item">
										<a class="submenu-link" href="@Url.Action("Index", "Goal")">View Goals</a>
									</li>
									<li class="submenu-item">
										<a class="submenu-link" href="@Url.Action("Create", "Goal")">Add Goals</a>
									</li>
									<li class="submenu-item">
										<a class="submenu-link" href="@Url.Action("TakeQuiz", "CareerAssessment")">Self Assessment</a>
									</li>
								</ul>
							</div>
						</li><!--//nav-item-->

						<li class="nav-item has-submenu">
							<a class="nav-link submenu-toggle" href="#" data-bs-toggle="collapse" data-bs-target="#submenu-1" aria-expanded="false" aria-controls="submenu-1">
								<span class="nav-icon">
									<i class="bi bi-file-earmark-text"></i> <!-- Resume-related icon -->
								</span>
								<span class="nav-link-text">Resume</span>
								<span class="submenu-arrow"> <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-chevron-down" fill="currentColor" xmlns="http://www.w3.org/2000/svg"> <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z" /> </svg> </span>
							</a>
							<div id="submenu-1" class="collapse submenu submenu-1" data-bs-parent="#menu-accordion">
								<ul class="submenu-list list-unstyled">
									<li class="submenu-item">
										<a class="submenu-link" href="@Url.Action("Index", "Resume")">View Resume</a>
									</li>
									<li class="submenu-item">
										<a class="submenu-link" href="@Url.Action("Create", "Resume")">Create Resume</a>
									</li>
								</ul>
							</div>
						</li><!--//nav-item-->

						<li class="nav-item has-submenu">
							<a class="nav-link submenu-toggle" href="#" data-bs-toggle="collapse" data-bs-target="#submenu-savedjobs" aria-expanded="false" aria-controls="submenu-savedjobs">
								<span class="nav-icon">
									<i class="bi bi-briefcase"></i> <!-- Applications-related icon -->
								</span>
								<span class="nav-link-text">Applications</span>
								<span class="submenu-arrow"> <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-chevron-down" fill="currentColor" xmlns="http://www.w3.org/2000/svg"> <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z" /> </svg> </span>
							</a>
							<div id="submenu-savedjobs" class="collapse submenu" data-bs-parent="#menu-accordion">
								<ul class="submenu-list list-unstyled">
									<li class="submenu-item">
										<a class="submenu-link" href="@Url.Action("SavedJobs", "SavedJobs")">Saved Jobs</a>
									</li>
									<li class="submenu-item">
										<a class="submenu-link" href="@Url.Action("MyJobApplications", "UserApplications")">Job Applications</a>
									</li>
									<li class="submenu-item">
										<a class="submenu-link" href="@Url.Action("MyEventApplications", "UserApplications")">Event Applications</a>
									</li>
									<li class="submenu-item">
										<a class="submenu-link" href="@Url.Action("MyMentorRequests", "UserApplications")">Mentor Meeting Applications</a>
									</li>
								</ul>
							</div>
						</li><!--//nav-item-->

						<li class="nav-item">
							<a class="nav-link" href="@Url.Action("Index", "UserRecycleBin")">
								<span class="nav-icon">
									<i class="bi bi-trash"></i> <!-- Recycle Bin icon -->
								</span>
								<span class="nav-link-text">Recycle Bin</span>
							</a>
						</li>


					</ul>
				</nav>
			</div><!--//sidepanel-inner-->
		</div><!--//app-sidepanel-->
		@RenderSection("Header", required: false)
	</header><!--//app-header-->

    <div class="app-wrapper">
        @RenderBody()
    </div>

    <!-- Javascript -->
    <script src="~/plugins/popper.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.min.js"></script>

    <!-- Charts JS -->
    @* <script src="~/plugins/chart.js/chart.min.js"></script>
    <script src="~/js/index-charts.js"></script> *@

    <!-- Page Specific JS -->
    <script src="~/js/app.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
