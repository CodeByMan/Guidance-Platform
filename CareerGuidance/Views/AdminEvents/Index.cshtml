@model IEnumerable<CareerGuidance.Models.Event>
@{
    ViewData["Title"] = "Manage Conferences";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4 bg-light">
    <div class="container-xl">

        <h3 class="text-info mb-4">Manage Conferences</h3>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Total Conferences: <span class="badge bg-info">@Model.Count()</span></h5>
            <div class="input-group w-50">
                <input type="text" id="searchInput" class="form-control" placeholder="Search by title, venue, date/time..." />
                <span class="input-group-text bg-info text-white"><i class="bi bi-search"></i></span>
            </div>
        </div>

        <hr>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h5 class="text-muted">No conferences found.</h5>
            </div>
        }
        else
        {
            <div class="row g-4" id="eventsList">
                @foreach (var item in Model)
                {
                    <div class="col-12 col-md-4 event-card">
                        <div class="card h-100 border-0 shadow-sm hover-shadow transition-all" style="min-height: 400px;">
                            <div class="position-relative">
                                <img src="~/images/@(string.IsNullOrEmpty(item.ImageSrc) ? "default-banner.jpg" : item.ImageSrc)"
                                     class="card-img-top rounded-top"
                                     alt="@(!string.IsNullOrEmpty(item.Title) ? item.Title : "Conference Banner")"
                                     style="height: 180px; object-fit: cover;">
                                <span class="badge bg-info position-absolute top-0 end-0 m-2"
                                      style="max-width: 200px; white-space: normal; word-wrap: break-word; font-size: 0.75rem;">
                                    @item.DateTimeText
                                </span>
                            </div>

                            <div class="card-body">
                                <h5 class="card-title text-info fw-semibold mb-2">@item.Title</h5>
                                <p class="card-text text-muted small mb-2">
                                    <i class="bi bi-geo-alt-fill me-1 text-danger"></i>@item.Venue
                                </p>
                                <p class="text-secondary small">
                                    @(item.Description?.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)
                                </p>
                            </div>

                            <div class="card-footer bg-light border-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <a asp-controller="AdminApplications" asp-action="EventApplicationsByEvent" asp-route-eventId="@item.EventId"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-people-fill me-1"></i>Applications
                                    </a>
                                </div>

                                <div class="d-flex gap-2">
                                    <a asp-controller="AdminEvents" asp-action="Edit" asp-route-id="@item.EventId"
                                       class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <!-- Simple Delete Form without antiforgery -->
                                    <form asp-controller="AdminEvents" asp-action="Delete" asp-route-id="@item.EventId" method="post" onsubmit="return confirm('Are you sure you want to delete this conference?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // TempData JS alert
        @if (TempData["msg"] != null)
        {
                <text>
                    alert('@TempData["msg"]');
                </text>
        }

        // Live Search
        const searchInput = document.getElementById('searchInput');
        searchInput.addEventListener('keyup', function () {
            const filter = this.value.toLowerCase();
            document.querySelectorAll('.event-card').forEach(card => {
                const title = card.querySelector('.card-title')?.textContent.toLowerCase() || '';
                const venue = card.querySelector('.card-text')?.textContent.toLowerCase() || '';
                const date = card.querySelector('.badge')?.textContent.toLowerCase() || '';

                card.style.display = (title.includes(filter) || venue.includes(filter) || date.includes(filter)) ? 'block' : 'none';
            });
        });

        // Hover Shadow
        document.querySelectorAll('.hover-shadow').forEach(card => {
            card.addEventListener('mouseenter', () => card.classList.add('shadow-lg'));
            card.addEventListener('mouseleave', () => card.classList.remove('shadow-lg'));
        });
    </script>
}
