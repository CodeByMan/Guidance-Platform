@model CareerGuidance.Models.Event
@{
    ViewData["Title"] = "Edit Conference";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4 bg-light">
    <div class="container-xl">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-info text-center py-2 rounded-top">
                <h5 class="mb-0" style="color: white !important;">
                    <i class="bi bi-camera-video-fill me-2"></i>Edit Conference
                </h5>
            </div>

            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data" novalidate>
                    <input type="hidden" asp-for="EventId" />
                    <input type="hidden" asp-for="Type" />
                    <input type="hidden" asp-for="ImageSrc" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="Enter conference title" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DateTimeText" class="form-label"></label>
                        <input asp-for="DateTimeText" class="form-control" placeholder="YYYY-MM-DD HH:MM" />
                        <span asp-validation-for="DateTimeText" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Venue" class="form-label"></label>
                        <input asp-for="Venue" class="form-control" placeholder="Enter venue" />
                        <span asp-validation-for="Venue" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" placeholder="Conference description"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ImageSrc))
                    {
                        <div class="mb-3">
                            <label class="form-label">Current Image:</label><br />
                            <img src="~/images/@Model.ImageSrc" alt="Event Image" class="img-thumbnail" width="200" />
                        </div>
                    }

                    <div class="mb-4">
                        <label class="form-label">Upload New Image (optional)</label>
                        <input type="file" name="imageFile" class="form-control" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-info">Update</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @if (TempData["msg"] != null)
        {
                <text>
                    alert("@TempData["msg"]");
                    window.location.href = '@Url.Action("Index", "AdminEvents")';
                </text>
        }
    </script>
}

