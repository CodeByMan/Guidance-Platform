@model List<Goal>
@{
    ViewData["Title"] = "User Dashboard";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4">
    <div class="container xl">
        <div class="row g-4 mb-4">
            <div class="col-12 d-flex justify-content-between align-items-center">
                <h2 class="mb-0 text-center">🎯 Your Goals</h2>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12">
                @foreach (var goal in Model)
                {
                    var total = goal.Steps.Count;
                    var done = goal.Steps.Count(s => s.IsCompleted);
                    var progress = total > 0 ? (int)((double)done / total * 100) : 0;
                    var complete = progress == 100;

                    <div class="card mb-3 shadow-sm">
                        <div class="app-card-body p-3 p-lg-4">
                            <h5 class="app-card-title d-flex align-items-center mb-2">Title:
                                @goal.Title
                                @if (complete)
                                {
                                    <span class="text-info ms-2" title="Completed">✔️</span>
                                }
                            </h5>
                            <p class="mb-2">Description: @goal.Description</p>
                            <p class="mb-2">Date: @goal.TargetDate.ToString("dd-MM-yyyy")</p>

                            <div class="progress mt-3">
                                <div class="progress-bar" role="progressbar" style="width: @progress%;" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100">
                                    @progress%
                                </div>
                            </div>

                            <a class="btn btn-info mt-4 me-2" href="/Goal/Details/@goal.GoalId">View Details</a>

                            <form asp-action="Delete" asp-controller="Goal" asp-route-id="@goal.GoalId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this goal?');">
                                <button type="submit" class="btn btn-danger mt-4">
                                    <i class="fa fa-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
