@model Goal
@{
    ViewData["Title"] = "User Dashboard";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4">
    <div class="container xl">

        <div class="alert alert-warning">
            <h4 class="alert-heading">⚠️ Confirm Delete</h4>
            <p>Are you sure you want to delete the following goal?</p>
        </div>

        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Target Date</dt>
            <dd class="col-sm-9">@Model.TargetDate.ToShortDateString()</dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-3">
            <input type="hidden" asp-for="GoalId" />
            <button type="submit" class="btn btn-danger">🗑️ Delete</button>
            <a asp-controller="Goal" asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>

    </<Bdiv>
</div>
