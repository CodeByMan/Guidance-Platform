@model Goal
@{
    ViewData["Title"] = "User Dashboard";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="app-content mt-5 pt-3 p-md-3 p-lg-4">
    <div class="container xl">

        <div class="card shadow-sm border-0">
            <div class="card-header bg-info text-center py-2 rounded-top">
                <h5 class="mb-0" style="color: white !important;">
                    <i class="bi bi-book-fill me-2"></i>Create New Goal
                </h5>
            </div>

            <div class="card-body p-4">

                <form method="post" class="mt-3">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Become a PHP Developer" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GoalType" class="form-label"></label>
                        <select asp-for="GoalType" class="form-select">
                            <option>Short-term</option>
                            <option>Long-term</option>
                        </select>
                        <span asp-validation-for="GoalType" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TargetDate" class="form-label"></label>
                        <input asp-for="TargetDate" type="date" class="form-control" />
                        <span asp-validation-for="TargetDate" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-info">💾 Save Goal</button>
                    <a href="/Goal" class="btn btn-secondary ms-2">Cancel</a>
                </form>

            </div> <!-- card-body -->
        </div> <!-- card -->

    </div> <!-- container -->
</div> <!-- app-content -->
